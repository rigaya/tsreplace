FROM ubuntu:20.04

ARG DEBIAN_FRONTEND=noninteractive
ARG FFMPEG_DLL_REPO=https://github.com/rigaya/build_scripts.git
ARG FFMPEG_DLL_REF=master
ARG BUILD_SCRIPTS_DIR=/opt/build_scripts
ARG FFMPEG_PREFIX=/opt/build_scripts/ffmpeg_dll/tsreplace/x64/build

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      wget \
      curl \
      git \
      ca-certificates \
      gnupg \
      lsb-release \
      autogen \
      autoconf \
      automake \
      libtool \
      autopoint gettext \
      make \
      pkg-config \
      yasm \
      patch \
      xz-utils \
      p7zip-full \
      unzip \
      bzip2 \
      python3 \
      python3-pip \
      gperf \
      libx11-dev \
      build-essential \
      openssl \
      libssl-dev \
    && NASM_ARCH="$(dpkg --print-architecture)" \
    && if [ "${NASM_ARCH}" = "arm64" ]; then \
         NASM_REPO=https://ports.ubuntu.com/ubuntu-ports; \
       else \
         NASM_REPO=https://archive.ubuntu.com/ubuntu; \
       fi \
    && wget -q "${NASM_REPO}/pool/universe/n/nasm/nasm_2.15.05-1_${NASM_ARCH}.deb" \
      -O /tmp/nasm.deb \
    && dpkg -i /tmp/nasm.deb \
    && rm -f /tmp/nasm.deb \
    && wget -O - https://apt.kitware.com/keys/kitware-archive-latest.asc \
        | gpg --dearmor \
        > /usr/share/keyrings/kitware-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] https://apt.kitware.com/ubuntu/ $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/kitware.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends cmake \
    && python3 -m pip install --upgrade pip \
    && python3 -m pip install --upgrade meson ninja \
    && meson --version \
    && which meson \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch ${FFMPEG_DLL_REF} ${FFMPEG_DLL_REPO} ${BUILD_SCRIPTS_DIR} \
    && cd ${BUILD_SCRIPTS_DIR}/ffmpeg_dll \
    && sed -i 's/\r$//' ./build_ffmpeg_dll.sh \
    && export NUMBER_OF_PROCESSORS="$(nproc)" \
    && bash ./build_ffmpeg_dll.sh --skip-src-archive --target tsreplace \
    && test -f "${FFMPEG_PREFIX}/lib/pkgconfig/libavutil.pc" \
    && find "${BUILD_SCRIPTS_DIR}" -mindepth 1 -maxdepth 1 ! -path "${BUILD_SCRIPTS_DIR}/ffmpeg_dll" -exec rm -rf {} + \
    && find "${BUILD_SCRIPTS_DIR}/ffmpeg_dll" -mindepth 1 -maxdepth 1 ! -path "${BUILD_SCRIPTS_DIR}/ffmpeg_dll/tsreplace" -exec rm -rf {} +

ENV FFMPEG_PREFIX=${FFMPEG_PREFIX}
WORKDIR /work
